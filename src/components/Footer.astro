---
import { site, whatsappLink } from '../config/site';
import { Github, Instagram, Linkedin, Mail, Phone } from 'lucide-astro';

const nav = [
	{ href: '/#servicos', label: 'Serviços' },
	{ href: '/#solucoes', label: 'Soluções' },
	{ href: '/#processo', label: 'Como trabalhamos' },
	{ href: '/#contato', label: 'Contato' },
];

const solutions = [
	{ href: '/solucoes/hotelaria', label: 'RP7 Hotelaria' },
	{ href: '/solucoes/imobiliarias', label: 'RP7 Imobiliárias' },
];

const socials = [
	{ href: site.social.linkedin, label: 'LinkedIn', Icon: Linkedin },
	{ href: site.social.instagram, label: 'Instagram', Icon: Instagram },
	{ href: site.social.github, label: 'GitHub', Icon: Github },
].filter((s) => s.href);
---

<footer class="bg-dark text-white">
	<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
		<div class="grid gap-12 md:grid-cols-2 lg:grid-cols-4">
			<div class="lg:col-span-2">
				<img
					src="/brand/svg/rp7-logo-negativa-transparente.svg"
					alt="RP7 Tech"
					class="h-16 w-auto"
					width="1832"
					height="718"
					loading="lazy"
				/>
				<p class="eyebrow mt-3 text-[0.625rem] text-white/50">
					Soluções digitais que geram resultados
				</p>
				<p class="mt-6 max-w-sm text-sm leading-relaxed text-white/60">
					{site.tagline}. Desenvolvemos software sob medida, sistemas integrados,
					integrações e aplicativos para empresas que querem crescer com tecnologia.
				</p>
			</div>

			<nav aria-label="Links do site">
				<h2 class="eyebrow text-white/40">Navegação</h2>
				<ul class="mt-4 space-y-2.5">
					{nav.map((l) => (
						<li>
							<a href={l.href} class="text-sm text-white/70 transition-colors hover:text-secondary">
								{l.label}
							</a>
						</li>
					))}
				</ul>
			</nav>

			<div>
				<h2 class="eyebrow text-white/40">Soluções</h2>
				<ul class="mt-4 space-y-2.5">
					{solutions.map((l) => (
						<li>
							<a href={l.href} class="text-sm text-white/70 transition-colors hover:text-secondary">
								{l.label}
							</a>
						</li>
					))}
				</ul>

				<h2 class="eyebrow mt-8 text-white/40">Contato</h2>
				<ul class="mt-4 space-y-2.5 text-sm text-white/70">
					<li>
						<a href={`mailto:${site.email}`} class="inline-flex items-center gap-2 transition-colors hover:text-secondary">
							<Mail class="h-4 w-4" aria-hidden="true" />
							{site.email}
						</a>
					</li>
					<li>
						<a href={whatsappLink()} class="inline-flex items-center gap-2 transition-colors hover:text-secondary" target="_blank" rel="noopener noreferrer">
							<Phone class="h-4 w-4" aria-hidden="true" />
							{site.phone}
						</a>
					</li>
				</ul>

				{socials.length > 0 && (
					<div class="mt-6 flex gap-3">
						{socials.map(({ href, label, Icon }) => (
							<a
								href={href}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={label}
								class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-white/10 text-white/70 transition-colors hover:bg-primary hover:text-white"
							>
								<Icon class="h-4 w-4" aria-hidden="true" />
							</a>
						))}
					</div>
				)}
			</div>
		</div>

		<div class="mt-14 flex flex-col items-center justify-between gap-3 border-t border-white/10 pt-8 text-xs text-white/40 sm:flex-row">
			<p>© {new Date().getFullYear()} {site.name}. Todos os direitos reservados.</p>
			{site.cnpj && <p>CNPJ {site.cnpj}</p>}
		</div>
	</div>
</footer>
