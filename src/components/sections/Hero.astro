---
import { whatsappLink } from '../../config/site';
import { ArrowRight } from 'lucide-astro';
---

<section class="diagonal-stripes relative bg-dark text-white">
	<div
		class="absolute inset-0 opacity-[0.04]"
		style="background-image: radial-gradient(circle at 1px 1px, #fff 1px, transparent 0); background-size: 2.5rem 2.5rem;"
		aria-hidden="true"
	></div>

	<div class="relative mx-auto flex max-w-7xl flex-col items-center px-4 pb-24 pt-40 text-center sm:px-6 sm:pb-32 sm:pt-48 lg:px-8">
		<p class="eyebrow brand-gradient-text reveal">Software house sob medida</p>

		<h1 class="reveal mt-6 max-w-4xl text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl">
			Software sob medida que faz sua empresa
			<span class="brand-gradient-text">crescer</span>
		</h1>

		<p class="reveal mt-6 max-w-2xl text-base leading-relaxed text-white/70 sm:text-lg">
			Desenvolvemos sistemas, integramos plataformas e criamos aplicativos
			para empresas que precisam de tecnologia feita para o seu negócio —
			não o contrário.
		</p>

		<div class="reveal mt-10 flex flex-col gap-4 sm:flex-row">
			<a
				href="/#contato"
				class="brand-gradient inline-flex items-center justify-center gap-2 rounded-xl px-8 py-4 text-base font-semibold text-white shadow-xl shadow-primary/30 transition-transform hover:scale-[1.03]"
			>
				Solicitar orçamento
				<ArrowRight class="h-5 w-5" aria-hidden="true" />
			</a>
			<a
				href="/#solucoes"
				class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/20 px-8 py-4 text-base font-semibold text-white transition-colors hover:border-white/40 hover:bg-white/5"
			>
				Conheça nossas soluções
			</a>
		</div>

		<img
			src="/brand/svg/rp7-simbolo.svg"
			alt=""
			aria-hidden="true"
			class="pointer-events-none absolute -right-24 top-1/2 hidden w-[28rem] opacity-[0.07] lg:block"
			width="662"
			height="500"
		/>
	</div>
</section>
