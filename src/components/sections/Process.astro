---
const steps = [
	{
		number: '01',
		title: 'Diagnóstico',
		description:
			'Entendemos o seu negócio, os processos e as dores antes de escrever qualquer linha de código.',
	},
	{
		number: '02',
		title: 'Planejamento',
		description:
			'Definimos escopo, prioridades e arquitetura. Você sabe o que será entregue, quando e por quê.',
	},
	{
		number: '03',
		title: 'Desenvolvimento ágil',
		description:
			'Entregas incrementais e validação constante — você acompanha a evolução e ajusta o rumo a cada ciclo.',
	},
	{
		number: '04',
		title: 'Entrega e suporte contínuo',
		description:
			'Deploy, treinamento e acompanhamento. O sistema evolui junto com a sua operação.',
	},
];
---

<section id="processo" class="bg-white py-20 sm:py-28">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="max-w-2xl">
			<p class="eyebrow brand-gradient-text reveal">Como trabalhamos</p>
			<h2 class="reveal mt-4 text-3xl font-bold tracking-tight text-dark sm:text-4xl">
				Processo claro, do diagnóstico ao suporte
			</h2>
		</div>

		<ol class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
			{
				steps.map((step) => (
					<li class="reveal relative">
						<span class="brand-gradient-text text-5xl font-extrabold">{step.number}</span>
						<h3 class="mt-4 text-lg font-semibold text-dark">{step.title}</h3>
						<p class="mt-2 text-sm leading-relaxed text-slate-text">{step.description}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>
