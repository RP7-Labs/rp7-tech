# Destino dos emails do formulário de contato.
# Precisa ser um endereço verificado em Email Routing (Cloudflare).
# Configure como variável do Worker em produção (Settings -> Variables and Secrets)
LEADS_EMAIL=seu-email-destino@example.com

# WhatsApp exibido no botão flutuante e links (somente dígitos, com DDI+DDD)
PUBLIC_WHATSAPP=5500000000000
